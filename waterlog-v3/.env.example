# ============================================================================
# waterlog-v3 环境变量样例
#
# 用法：
#   cp .env.example .env      # 本机开发，start.ps1 会自动读取 .env
#   docker compose --env-file .env up -d
#
# 所有变量都有默认值，不配也能跑起来；下面按「改了会影响什么」分组。
# ============================================================================

# ---------------------------------------------------------------- 服务端口
# Go API 对外端口（前端通过它访问全部接口；生产环境由 nginx 反代到这里）
WL_API_PORT=8200

# Python 引擎端口。它不对外暴露，只有 Go API 会连它。
WL_ENGINE_PORT=8201

# ---------------------------------------------------------------- 数据落盘
# Go 侧 SQLite 文件（遥测、预测快照、预警事件、处置备注、审计日志都在这里）
WL_API_DB=data/waterlog.db

# Python 引擎的数据目录（数据集 npz、模型 joblib、评估库、修正器状态、仿真时钟）
WL_ENGINE_DATA=data

# 前端构建产物目录（Go API 直接托管静态文件，SPA 深链回退 index.html）
WL_WEB_DIR=../web/dist

# ---------------------------------------------------------------- 服务间寻址
# Go API 反代引擎用的地址（容器里要写成 http://engine:8201）
WL_ENGINE_URL=http://127.0.0.1:8201

# 引擎主动把遥测/预测推给谁（容器里要写成 http://api:8200）
WL_GO_API=http://127.0.0.1:8200

# 引擎是否主动推送。设为 0 时它只被动响应 /forecast，适合只做离线训练的场景。
WL_ENGINE_PUSH=1

# ---------------------------------------------------------------- 仿真节奏
# 每 tick 推进 1 个仿真步（STEP_MIN=5 分钟）。5 秒 1 tick = 60 倍速。
WL_TICK_SEC=5

# 天气自动生成（演示用）：到达率 / 场次峰值 / 背景雨幅度。
# 默认值取「屏幕上一直在动」而不是「最真实」——真实频率按 60 倍速折算
# 约半小时墙钟一场，中间读数一动不动，看着像数据源死了。
WL_RAIN_RATE_SCALE=5.0
WL_RAIN_PEAK_SCALE=1.6
WL_RAIN_BG_MM=2.2

# 每多少秒出一轮预测（对应仿真时间 60 分钟，也就是预报发布周期）
WL_FORECAST_EVERY_SEC=60

# 模拟器随机种子。换种子等于换一个气候年，历史数据与训练结果都会变。
WL_SIM_SEED=20261021

# ---------------------------------------------------------------- 可观测性
# 日志格式：text（人读）| json（采集器读）
WL_LOG_FORMAT=text

# 日志级别：debug | info | warn | error
WL_LOG_LEVEL=info

# ---------------------------------------------------------------- 鉴权
# 会话签名密钥。**生产环境必须改**，否则任何人可以伪造 token。
WL_SESSION_SECRET=dev-only-change-me

# 会话有效期（小时）。值班班次通常 8~12 小时。
WL_SESSION_TTL_H=12

# 首次启动时自动创建的管理员口令（仅当用户表为空时生效）
WL_BOOTSTRAP_ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------- 通知
# 预警触发时的默认通知渠道。multiple 用逗号分隔：inapp,webhook
WL_NOTIFY_CHANNELS=inapp

# 通用 webhook 地址（企业微信/钉钉/飞书的机器人 URL 都填这里）
WL_NOTIFY_WEBHOOK_URL=

# webhook 签名密钥（可选，部分机器人要求）
WL_NOTIFY_WEBHOOK_SECRET=
