# ===== 前端环境变量（复制为 .env 后按需修改）=====

# 后端 API 基础地址：
# - 开发模式（vite dev）：留空走 vite.config.ts 的 /api 代理到 http://localhost:8080，或填后端完整地址 http://localhost:8080/api/v1
# - 生产模式（nginx 托管 dist）：默认 /api/v1，由 nginx 把 /api 反代到后端服务
VITE_API_BASE_URL=/api/v1

# 开发代理目标（仅 vite dev 生效，指向 Go 后端监听地址）
VITE_PROXY_TARGET=http://localhost:8080

# 天地图瓦片服务 token（申请：https://console.tianditu.gov.cn）
# 未配置时地图自动跳过天地图源，直接使用 OpenStreetMap 降级链，页面不报错
VITE_TIANDITU_TOKEN=
